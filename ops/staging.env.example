# Staging: a closed copy for testing before production. Same setup, its own domains, database,
# keys and backups. Copy to ops/staging.env and start with -p mosta3lem-staging (see
# docker-compose.yml). Never reuse production's FILES_KEY or passwords here.

CONSOLE_DOMAIN=staging-console.mosta3lem.example
API_DOMAIN=staging-api.mosta3lem.example

# live with test accounts (npm run create-admin), or demo for the demo data and "sign in as".
MOSTA3LEM_MODE=live

POSTGRES_PASSWORD=
FILES_KEY=

# Codes and links appear in the API log instead of being sent: fine for a closed staging server.
MESSAGING_DRIVER=dev
ALLOW_DEV_MESSAGING=true
PUSH_DRIVER=dev
EXPO_ACCESS_TOKEN=

ALERT_EMAILS=
BACKUP_HOUR=1
BACKUP_KEEP_DAYS=7
BACKUP_PATH=./backups-staging
