# HTTPS in front of Mosta3lem. Caddy gets and renews the certificates by itself once both
# domains point at this server. The API's copies are found by name, so both get requests.
{$API_DOMAIN} {
	encode gzip
	reverse_proxy {
		dynamic a api 4000
		lb_policy round_robin
		health_uri /health
	}
}

{$CONSOLE_DOMAIN} {
	encode gzip
	reverse_proxy console:3600
}
