# Production settings for ops/docker-compose.yml. Copy to ops/.env, fill in, keep out of git,
# and keep FILES_KEY and POSTGRES_PASSWORD in the cloud's secret store as well.

# Where the console and the API answer (both must point at this server for HTTPS).
CONSOLE_DOMAIN=console.mosta3lem.example
API_DOMAIN=api.mosta3lem.example

MOSTA3LEM_MODE=live

# Long random values. Make each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
POSTGRES_PASSWORD=
# Encrypts files and authenticator secrets. Back it up apart from the database backups.
FILES_KEY=

# The SMS and email provider once chosen (dev only prints messages in the log).
MESSAGING_DRIVER=dev
ALLOW_DEV_MESSAGING=false
# Push to phones: expo, with the token from the Expo account.
PUSH_DRIVER=dev
EXPO_ACCESS_TOKEN=

# Who gets an email when backups, deliveries or the background clock need a person.
ALERT_EMAILS=ops@mosta3lem.example

# Daily backup at this hour (UTC; 0 is 2:00 or 3:00 in Cairo), kept this many days, into this
# folder on the server. Copy that folder to the cloud's storage in Egypt as well.
BACKUP_HOUR=0
BACKUP_KEEP_DAYS=30
BACKUP_PATH=./backups
