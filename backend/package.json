{
  "name": "mosta3lem-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Mosta3lem API: the shared engine behind a real API, with PostgreSQL.",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "test": "node --test test/*.test.js",
    "create-admin": "node --env-file-if-exists=.env src/create-admin.js",
    "reset-authenticator": "node --env-file-if-exists=.env src/reset-authenticator.js",
    "rotate-files-key": "node --env-file-if-exists=.env src/rotate-files-key.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.12.5",
    "pg": "^8.23.1"
  }
}
