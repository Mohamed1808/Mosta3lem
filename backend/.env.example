# Copy to .env (never commit .env). Every setting is optional for local development.

# demo: the demo data and "sign in as" anyone. live: an empty platform, real sign-in only.
MOSTA3LEM_MODE=demo
PORT=4000

# Who delivers SMS and email. dev prints messages in the log and the outbox table (nothing
# is really sent). Live mode refuses dev unless ALLOW_DEV_MESSAGING=true (closed staging only).
MESSAGING_DRIVER=dev
ALLOW_DEV_MESSAGING=false

# Where invitation and reset links point (the console address).
PUBLIC_URL=http://localhost:3600

# A real PostgreSQL server. Leave empty to use PGlite (PostgreSQL inside Node) in PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=.data/pglite

# Web pages allowed to call the API (the console and the app in a browser).
CORS_ORIGINS=http://localhost:3600,http://localhost:8081

# How long a sign-in lasts, in hours (168 = 7 days).
SESSION_HOURS=168
# How often deadlines and offer expiry are checked, in seconds.
TICK_SECONDS=30
# Requests per minute from one address: everything, and the sign-in routes.
REQUESTS_PER_MINUTE=300
SIGN_IN_PER_MINUTE=10
# Largest request, in MB (photos travel inside requests until file storage arrives).
BODY_LIMIT_MB=15
LOG_LEVEL=info
