# Copy to .env (never commit .env). Every setting is optional for local development.

# demo: the demo data and "sign in as" anyone. live: an empty platform, real sign-in only.
MOSTA3LEM_MODE=demo
PORT=4000

# Who delivers SMS and email. dev prints messages in the log and the outbox table (nothing
# is really sent). Live mode refuses dev unless ALLOW_DEV_MESSAGING=true (closed staging only).
MESSAGING_DRIVER=dev
ALLOW_DEV_MESSAGING=false

# Phone push notifications. dev: log and outbox only. expo: the Expo push service.
PUSH_DRIVER=dev
EXPO_ACCESS_TOKEN=

# Where invitation and reset links point (the console address).
PUBLIC_URL=http://localhost:3600

# A real PostgreSQL server. Leave empty to use PGlite (PostgreSQL inside Node) in PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=.data/pglite

# Web pages allowed to call the API (the console and the app in a browser). Demo mode
# defaults to the local console and app; live mode allows none until they are listed.
CORS_ORIGINS=http://localhost:3600,http://localhost:8081

# The proxy in front of the API (its address or addresses), so the real caller address is
# used for rate limits and https is recognised. Empty when there is no proxy.
TRUST_PROXY=

# How long a sign-in lasts, in hours (168 = 7 days), and how long it may go unused:
# platform staff 8 hours, everyone else 72.
SESSION_HOURS=168
SESSION_IDLE_HOURS=72
STAFF_IDLE_HOURS=8
# How often deadlines and offer expiry are checked, in seconds.
TICK_SECONDS=30
# Files (photos and documents). local: a folder on this server; memory: tests only.
# FILES_KEY encrypts them: 32 random bytes, base64. Required in live mode; keep it secret and
# backed up, since files cannot be read without it. In demo mode one is created in FILES_DIR.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FILES_DRIVER=local
FILES_DIR=.data/files
FILES_KEY=
FILE_MAX_MB=8
# The API's public address, for file links. Empty: the address the caller used.
PUBLIC_API_URL=

# Requests per minute from one address: everything, and the sign-in routes.
REQUESTS_PER_MINUTE=300
SIGN_IN_PER_MINUTE=10
# Where the counts are kept: database (all copies count together) or memory (each copy alone).
RATE_LIMIT_STORE=database
# Largest request, in MB (photos travel inside requests until file storage arrives).
BODY_LIMIT_MB=15
LOG_LEVEL=info
